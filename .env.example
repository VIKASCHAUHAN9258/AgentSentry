# AgentSentry environment configuration (copy to .env)

AGENTSENTRY_ENV=development
AGENTSENTRY_LOG_LEVEL=INFO

# Required by the Flask API outside explicit test mode.
# Replace with a random secret of at least 32 characters; never commit the value.
AGENTSENTRY_API_KEY=

# Comma-separated browser origins permitted to call the API.
AGENTSENTRY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional; defaults to the project-local models directory.
# AGENTSENTRY_MODEL_DIR=models
